// ==================================================
// 桌面端三栏布局 (屏幕宽度 > 1200px)
// ==================================================
@media (min-width: 1200px) {

  // 1. 隐藏原本的 Header (防止左上角出现多余的白块)
  body > .container > .header {
    display: none !important;
  }

  // 2. 主容器 Flex 布局
  .main-inner {
    display: flex !important;
    justify-content: center;
    align-items: flex-start !important;
    width: 100% !important;
    margin-top: 20px !important;
  }

  // 3. 左侧栏容器
  .content-wrap-left {
    width: 240px;
    flex-shrink: 0;
    order: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  // --- 修复白块的核心代码 ---
  .desktop-header-fix {
    background: transparent !important; // 必须透明
    padding: 0 !important;
    margin: 0 !important;
  }
  
  // 确保黑色方块撑满
  .desktop-header-fix .site-brand-container {
    display: block !important;
    width: 100% !important;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
  }
  
  // 菜单栏样式
  .desktop-header-fix .site-nav {
    display: block !important;
    background: #fff;
    margin-top: 12px; 
    padding: 10px;
    border-radius: 3px;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
  }

  // 左侧头像栏样式
  .sidebar {
    position: static !important;
    width: 100% !important;
    margin-top: 0 !important;
    background: #fff;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    padding: 0 !important;
    border-radius: 3px;
  }
  .sidebar-inner {
    position: static !important;
    width: 100% !important;
    padding: 15px 10px;
    box-sizing: border-box;
    background: #fff;
    text-align: center;
  }

  // 4. 中间内容区 (修复重叠)
  .content-wrap {
    flex: 1;
    min-width: 0;
    width: auto !important;
    margin: 0 20px !important; // 左右各加 20px 间距，防止重叠
    padding: 40px;
    background: #fff;
    order: 2;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    border-radius: 3px;
  }

  // 5. 右侧栏容器
  .content-wrap-right {
    width: 240px;
    flex-shrink: 0;
    order: 3;
  }
  
  // 右侧栏内部样式
  .right-sidebar {
    background: #fff;
    padding: 15px;
    border-radius: 3px;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    position: sticky;
    top: 20px;
  }
}

// ==================================================
// 移动端适配
// ==================================================
@media (max-width: 1199px) {
  .content-wrap-right { display: none; }
  .content-wrap-left { display: none; }
  body > .container > .header { display: block !important; }
  .main-inner { display: block !important; }
}
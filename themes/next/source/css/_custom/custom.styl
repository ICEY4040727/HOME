// ==================================================
// 桌面端三栏布局 (屏幕宽度 > 1200px)
// ==================================================
@media (min-width: 1200px) {

  // 1. 隐藏原本页面顶部的 Header
  body > .container > .header {
    display: none !important;
  }

  // 2. 主容器 Flex 布局 (恢复 Flex，它是最稳的)
  .main-inner {
    display: flex !important;
    justify-content: center;
    align-items: flex-start !important; // 关键：顶部对齐
    width: 100% !important;
    max-width: 1400px; // 限制最大宽度，防止太宽
    margin: 20px auto !important;
  }

  // 3. 左侧栏容器 (Sticky 效果)
  .content-wrap-left {
    width: 240px;
    flex-shrink: 0;
    order: 1;
    display: flex !important;
    flex-direction: column;
    gap: 12px;
    
    // === 核心修改：让左栏固定 ===
    position: sticky !important;
    top: 20px; // 距离屏幕顶部的距离
    height: fit-content; // 高度自适应内容
    // ==========================
  }

  // 4. 修复黑色标题栏
  .desktop-header-fix {
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    position: relative !important;
  }
  
  // 强制 Header 内部元素回归文档流
  .desktop-header-fix .header-inner,
  .desktop-header-fix .site-meta {
    position: static !important;
    display: block !important;
    width: 100% !important;
  }

  // 修复黑色背景区域宽度
  .desktop-header-fix .site-brand-container {
    position: static !important;
    display: block !important;
    width: 100% !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
  }
  
  // 菜单栏样式
  .desktop-header-fix .site-nav {
    position: static !important;
    display: block !important;
    background: #fff;
    margin-top: 12px;
    padding: 10px;
    border-radius: 3px;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    width: 100% !important;
    box-sizing: border-box !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  
  .desktop-header-fix .menu {
    position: static !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  // 5. 左侧头像栏样式
  .sidebar {
    position: static !important;
    width: 100% !important;
    margin-top: 0 !important;
    background: #fff;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    padding: 0 !important;
    border-radius: 3px;
    display: block !important; // 确保显示
  }
  .sidebar-inner {
    position: static !important;
    width: 100% !important;
    padding: 15px 10px;
    box-sizing: border-box;
    background: #fff;
    text-align: center;
  }
  
  // 隐藏桌面端的侧边栏开关
  .sidebar-toggle {
    display: none !important;
  }

  // 6. 中间内容区
  .content-wrap {
    flex: 1;
    min-width: 0;
    width: auto !important;
    margin: 0 20px !important;
    padding: 40px;
    background: #fff;
    order: 2;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
    border-radius: 3px;
  }

  // 7. 右侧栏容器 (Sticky 效果)
  .content-wrap-right {
    width: 240px;
    flex-shrink: 0;
    order: 3;
    
    // === 核心修改：让右栏固定 ===
    position: sticky !important;
    top: 20px; // 距离屏幕顶部的距离
    height: fit-content;
    // ==========================
  }
  
  .right-sidebar {
    background: #fff;
    padding: 15px;
    border-radius: 3px;
    box-shadow: 0 2px 2px 0 rgba(0,0,0,0.12);
  }
}

// ==================================================
// 移动端适配
// ==================================================
@media (max-width: 1199px) {
  .content-wrap-right { display: none !important; }
  .content-wrap-left { display: none !important; }
  body > .container > .header { display: block !important; }
  .main-inner { display: block !important; }
}